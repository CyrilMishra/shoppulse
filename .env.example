# Copy to .env (never commit .env). Used by services/ai-support-service.

# --- LLM providers (use at least one) ---
# Ollama runs locally, no key needed. Install: winget install Ollama.Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Free hosted tier (pick one; both have generous free quotas):
# Groq:   https://console.groq.com  (fast llama models)
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Vector DB ---
QDRANT_URL=http://localhost:6333

# --- Langfuse (self-hosted, http://localhost:3002 — create org+project in UI, then paste keys) ---
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- ShopPulse backend (for tool calling against your own APIs) ---
GATEWAY_URL=http://localhost:8080
